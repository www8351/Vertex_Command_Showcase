# ============================================================================
# Vertex Command — environment template (ROOT production stack / Path A)
# Copy to .env and fill in. .env is gitignored and never committed.
#   cp .env.example .env
# Tags: [REQUIRED] app/compose fails without it · [OPTIONAL] feature-gated, safe blank
# ============================================================================

# --- Database [REQUIRED] -----------------------------------------------------
# POSTGRES_PASSWORD is hard-required by compose (${POSTGRES_PASSWORD:?} in docker-compose.yml).
POSTGRES_USER=vertex
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=vertex_command

# --- Session [REQUIRED] ------------------------------------------------------
# Hard-required by compose (${SESSION_SECRET:?}) and by the app in production.
# Generate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING

# --- Credential encryption [REQUIRED] ----------------------------------------
# Reaches the app ONLY via env_file (.env). App aborts at boot if missing/invalid
# (server/encryption.ts). Must be exactly 64 hex chars = 32 bytes.
# Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_32_BYTES

# --- TLS / domain [REQUIRED for production HTTPS + certbot] -------------------
# Used by nginx ingress + Let's Encrypt. For pure local HTTP testing, localhost is fine.
VERTEX_DOMAIN=vertex.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# --- Signal webhooks [OPTIONAL] ----------------------------------------------
# Needed only for TradingView/algorithmic signal ingestion. If unset, all signal
# webhooks are rejected (HMAC verification disabled); the rest of the app runs.
SIGNAL_WEBHOOK_SECRET=CHANGE_ME_SIGNAL_HMAC_SECRET

# --- Broker integrations [OPTIONAL] ------------------------------------------
# Only required to connect the corresponding broker. App boots without them.
TOPSTEPX_API_KEY=
TOPSTEPX_USERNAME=
TOPSTEPX_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SECRET=

# --- Billing / Stripe [OPTIONAL] ---------------------------------------------
# Only required for billing features. /api/health reports stripe=false if unset (still 200).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI chatbot [OPTIONAL] ---------------------------------------------------
OPENAI_API_KEY=

# --- Google Sign-In [OPTIONAL] -----------------------------------------------
# OAuth 2.0 Web Client ID from Google Cloud Console (APIs & Services > Credentials).
# If unset, the "Continue with Google" button is hidden and /api/v1/auth/google
# returns 503; email/password login is unaffected. Setup: see GOOGLE_SIGNIN_SETUP.md.
# The same value is the public client_id exposed to the browser via
# GET /api/v1/auth/google-config (no client secret is needed for the GIS token flow).
GOOGLE_CLIENT_ID=

# --- Frontend (Vercel split deploy) [REQUIRED for the Vercel + VPS architecture] ---
# The SPA is hosted on Vercel (https://syncer-q.vercel.app) and calls THIS backend
# cross-origin. These three make CORS + cookies work across origins.
#
# Backend side (set here on the VPS):
#   FRONTEND_ORIGINS  — comma-separated exact origins allowed by CORS.
#   CROSS_SITE_COOKIES=true — set session cookie SameSite=None; Secure (REQUIRED for
#                       cross-site cookies; needs HTTPS, provided by nginx+certbot).
#   ALLOW_VERCEL_PREVIEWS=true — also allow *.vercel.app preview deploys (CORS regex).
# Leave all three blank ONLY for same-origin / local dev (cookie stays SameSite=Lax).
FRONTEND_ORIGINS=https://syncer-q.vercel.app
CROSS_SITE_COOKIES=true
ALLOW_VERCEL_PREVIEWS=true
#
# Frontend build side (set in the Vercel project Environment Variables, NOT here):
#   VITE_API_URL=https://<this-backend-host>  — base URL the SPA calls (e.g.
#                       https://api.syncer-q.com). Empty = same-origin (local dev).

# --- Ingress host ports [OPTIONAL] -------------------------------------------
# Override published ports of the nginx ingress (defaults 80/443). Useful on dev
# machines where 80/443 are taken, e.g. HTTP_PORT=8080 HTTPS_PORT=8443.
HTTP_PORT=80
HTTPS_PORT=443

# --- Seeding scripts [OPTIONAL] ----------------------------------------------
# Used only by scripts/seed-admin.ts and scripts/seed-demo-users.ts.
# Never hardcode credentials in source — these are read from the environment.
ADMIN_EMAIL=admin@example.com
# Comma-separated admin allowlist used by integrations OAuth (server-side authz).
ADMIN_EMAILS=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=          # REQUIRED to run seed-admin; set a strong value, never commit it
DEMO_PASSWORD=ChangeMe123!
